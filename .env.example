# Copy to .env — never commit real secrets.
AGENTEVALOPS_DATABASE_URL=sqlite:///./agentevalops.db
AGENTEVALOPS_ARTIFACT_DIR=./artifacts
AGENTEVALOPS_BENCHMARK_DIR=./benchmarks/examples
AGENTEVALOPS_HARBOR_DIR=./benchmarks/harbor
AGENTEVALOPS_ADMIN_KEY=dev-admin-key-change-me
AGENTEVALOPS_APPROVER_KEY=dev-approver-key-change-me
AGENTEVALOPS_OPERATOR_KEY=dev-operator-key-change-me
AGENTEVALOPS_VIEWER_KEY=dev-viewer-key-change-me
AGENTEVALOPS_ALLOW_ANONYMOUS=true
AGENTEVALOPS_EXECUTION_MODE=subprocess
AGENTEVALOPS_MAX_CONCURRENCY=4
AGENTEVALOPS_TRIAL_TIMEOUT_SEC=120
AGENTEVALOPS_MONTHLY_BUDGET_USD=0
AGENTEVALOPS_OLLAMA_BASE_URL=http://localhost:11434/v1
AGENTEVALOPS_CORS_ORIGINS=*
# Optional provider keys (server-side only, never in the database):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# AZURE_OPENAI_API_KEY=
# VLLM_API_KEY=